{
  "name": "pi-crux",
  "version": "0.1.0",
  "description": "Pi extension that enforces Crux rules: company/team resolution, write-scope guard, context budget, crux_delegate tool and /crux-inbox command.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "crux"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
